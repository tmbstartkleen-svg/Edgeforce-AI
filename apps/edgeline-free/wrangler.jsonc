{
  "name": "edgeline-free",
  "account_id": "de9b84b39940a0b5b622ae5d27b415dc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "D1_SPORTS_MARKET_ARCHIVE_ENABLED": "false",
    "ATLAS_SCHEDULE_EXECUTION_ENABLED": "false",
    "PAID_ODDS_ENABLED": "false",
    "FREE_ODDS_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FREE_ODDS",
        "class_name": "FreeOdds"
      }
    ]
  },
  "migrations": [
    {
      "tag": "free-odds-v1",
      "new_sqlite_classes": [
        "FreeOdds"
      ]
    }
  ]
}